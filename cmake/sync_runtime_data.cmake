cmake_minimum_required(VERSION 3.24)
# Mirror generated runtime resources, preserving separately managed subtrees (e.g. PROJ).
foreach(required SOURCE_DIR DESTINATION_DIR BUILD_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Runtime data sync needs ${required}")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${SOURCE_DIR}")
    message(FATAL_ERROR "Runtime data source is missing: ${SOURCE_DIR}")
endif()
file(REAL_PATH "${SOURCE_DIR}" source)
file(REAL_PATH "${DESTINATION_DIR}" destination)
file(REAL_PATH "${BUILD_DIR}" build)
cmake_path(IS_PREFIX build "${destination}" NORMALIZE within_build)
cmake_path(IS_PREFIX source "${destination}" NORMALIZE within_source)
cmake_path(IS_PREFIX destination "${source}" NORMALIZE contains_source)
if(NOT within_build OR destination STREQUAL build OR within_source OR contains_source)
    message(FATAL_ERROR "Runtime data destination must be inside the build and separate from the source")
endif()
# Copy first: a failed copy must not prune the previous usable resources.
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_directory "${source}" "${destination}"
                COMMAND_ERROR_IS_FATAL ANY)
file(GLOB_RECURSE copied LIST_DIRECTORIES FALSE RELATIVE "${destination}" "${destination}/*")
foreach(entry IN LISTS copied)
    set(preserved FALSE)
    foreach(subtree IN LISTS PRESERVE_PATHS)
        cmake_path(IS_PREFIX subtree "${entry}" NORMALIZE in_subtree)
        if(in_subtree)
            set(preserved TRUE)
        endif()
    endforeach()
    if(NOT preserved AND NOT EXISTS "${source}/${entry}" AND NOT IS_SYMLINK "${source}/${entry}")
        file(REMOVE "${destination}/${entry}")
    endif()
endforeach()
