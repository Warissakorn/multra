function(require_json json expected)
    string(JSON actual GET "${json}" ${ARGN})
    if(expected MATCHES "^[0-9]+$" AND actual EQUAL expected)
        return() # JSON's 1200 and 1200.0 are the same count.
    endif()
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${ARGN} = ${expected}, got ${actual}")
    endif()
endfunction()
function(require_manifest report sha)
    string(JSON count LENGTH "${report}" inputManifest files)
    math(EXPR last "${count} - 1")
    set(found OFF)
    foreach(index RANGE ${last})
        string(JSON path GET "${report}" inputManifest files ${index} logicalPath)
        if(path STREQUAL "project")
            require_json("${report}" "${sha}" inputManifest files ${index} sha256)
            set(found ON)
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Missing original project provenance")
    endif()
endfunction()
function(require_between report low high)
    string(JSON actual GET "${report}" ${ARGN})
    if(actual LESS low OR actual GREATER high)
        message(FATAL_ERROR "${ARGN} = ${actual}, expected [${low}, ${high}]")
    endif()
endfunction()
foreach(kind IN ITEMS normal named)
    set(selection --macro matrix:am)
    if(kind STREQUAL "named")
        set(selection --macro-run roads-am)
    endif()
    execute_process(COMMAND "${CLI}" --project "${project_file}" --data-dir "${DATA}" ${selection}
        --csv "${TEST_ROOT}/${kind}.csv" RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Street segment Macro CLI failed: ${result}; ${error}")
    endif()
    require_json("${report}" ON converged)
    require_json("${report}" OFF validated)
    require_json("${report}" 1200 links 0 flow composition:urban-mixed)
    require_json("${report}" 1260 links 0 load)
    require_json("${report}" 0 links 1 flow composition:urban-mixed)
    require_json("${report}" 1200 links 2 flow composition:urban-mixed)
    require_manifest("${report}" "${source_sha}")
    file(READ "${TEST_ROOT}/${kind}.csv" csv)
    string(FIND "${csv}" "# MULTRA - not yet validated." marker)
    if(NOT marker EQUAL 0 OR NOT csv MATCHES "west.*1200.*1260")
        message(FATAL_ERROR "Road Macro CSV lost marker or assigned flow")
    endif()
    if(kind STREQUAL "named")
        require_json("${report}" roads-am runDefinition id)
    endif()
endforeach()
# D341: bidirectional Meso OD, with time to drain after demand ends.
set(meso_fixture "${fixture}")
string(JSON meso_fixture SET "${meso_fixture}" definition duration 1800)
string(JSON meso_fixture SET "${meso_fixture}" odMatrices 0 endTime 900)
string(JSON meso_fixture SET "${meso_fixture}" odMatrices 0 cells [=[[[0,100],[50,0]]]=])
string(JSON meso_fixture SET "${meso_fixture}" zoneConnectors 2
    [[{"id":"back-in","zoneId":"town","roadId":"east","roadDirection":"backward","direction":"origin","share":1}]])
string(JSON meso_fixture SET "${meso_fixture}" zoneConnectors 3
    [[{"id":"back-out","zoneId":"site","roadId":"west","roadDirection":"backward","direction":"destination","share":1}]])
set(meso_file "${TEST_ROOT}/meso-roads.traffic.json")
file(WRITE "${meso_file}" "${meso_fixture}\n")
file(SHA256 "${meso_file}" meso_sha)
execute_process(COMMAND "${CLI}" --project "${meso_file}" --data-dir "${DATA}" --meso --csv "${TEST_ROOT}/meso.csv"
    RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Road Meso CLI failed: ${result}; ${error}")
endif()
require_json("${report}" minimum-free-flow-time odPathRule)
require_json("${report}" OFF validated)
require_between("${report}" 149.999999 150.000001 classes 0 demanded)
require_between("${report}" 149.999999 150.000001 classes 0 arrived)
require_between("${report}" -0.000001 0.000001 classes 0 waiting)
require_between("${report}" -0.000001 0.000001 totals storedAtEnd)
require_manifest("${report}" "${meso_sha}")
file(READ "${TEST_ROOT}/meso.csv" csv)
if(NOT csv MATCHES "# OD path rule: minimum-free-flow-time" OR NOT csv MATCHES "# MULTRA - not yet validated")
    message(FATAL_ERROR "Meso CSV lost the path rule or unvalidated marker")
endif()
execute_process(COMMAND "${CLI}" --project "${meso_file}" --data-dir "${DATA}" --meso
    RESULT_VARIABLE result OUTPUT_VARIABLE replay ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT replay STREQUAL report)
    message(FATAL_ERROR "Meso Road replay changed: ${result}; ${error}")
endif()
function(refuse_meso json code)
    set(file "${TEST_ROOT}/refused-meso.traffic.json")
    file(WRITE "${file}" "${json}\n")
    execute_process(COMMAND "${CLI}" --project "${file}" --data-dir "${DATA}" --meso
        RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 1 OR NOT error MATCHES "${code}")
        message(FATAL_ERROR "Expected ${code}, got ${result}; ${error}")
    endif()
endfunction()
set(oneway "${meso_fixture}")
string(JSON oneway SET "${oneway}" definition crossSections 0 directions 1)
string(JSON oneway SET "${oneway}" definition crossSections 0 lanesBackward 0)
refuse_meso("${oneway}" MESO_ZONE_STREET_SEGMENT_UNAVAILABLE)
string(JSON outside SET "${meso_fixture}" odMatrices 0 endTime 3600)
refuse_meso("${outside}" OD_PERIOD_INVALID)
string(JSON restricted SET "${meso_fixture}" definition modes
    [=[[{"id":"car","name":"Car","compositionId":"urban-mixed"},{"id":"bus","name":"Bus","compositionId":"urban-mixed"}]]=])
string(JSON restricted SET "${restricted}" definition linkTypes 0 modes [[ ["car"] ]])
string(JSON restricted REMOVE "${restricted}" odMatrices 0 compositionId)
string(JSON restricted SET "${restricted}" odMatrices 0 modeId [["bus"]])
refuse_meso("${restricted}" MESO_OD_NO_PATH)
execute_process(COMMAND "${CLI}" --project "${project_file}" --data-dir "${DATA}" --seed 42
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR NOT error MATCHES "ZONE_CONNECTOR_STREET_SEGMENT_REQUIRES_LINKS")
    message(FATAL_ERROR "Micro silently accepted Road demand: ${result}; ${error}")
endif()
file(SHA256 "${meso_file}" meso_after_sha)
