# M12 R1 row SC7 (docs/reference/SUBAREA_CONSISTENCY.md §7, D553): the real CLI writes the consistency
# report as JSON and CSV with the marker and exact hashes, refuses a project without a study area, and
# shows a stale Macro side file in the marking. Two runs give the same bytes.
cmake_minimum_required(VERSION 3.24)
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}")
execute_process(COMMAND "${FIXTURE}" "${TEST_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "consistency fixture: result=${result}, output=${output}, error=${error}")
endif()
file(READ "${TEST_ROOT}/expected.json" expected)
string(JSON project GET "${expected}" project)
string(JSON source GET "${expected}" source)
function(require_json json expected_value)
    string(JSON actual ERROR_VARIABLE error GET "${json}" ${ARGN})
    if(error OR NOT "${actual}" STREQUAL "${expected_value}")
        message(FATAL_ERROR "JSON ${ARGN}: expected '${expected_value}', got '${actual}'; ${error}")
    endif()
endfunction()
function(report label)
    execute_process(COMMAND "${CLI}" --data-dir "${DATA}" --project "${TEST_ROOT}/${label}.traffic.json" --seeds 42-43
                            --consistency-report "${TEST_ROOT}/${label}.json" --csv "${TEST_ROOT}/${label}.csv"
                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${label}: result=${result}, output=${output}, error=${error}")
    endif()
endfunction()
report(area)
file(READ "${TEST_ROOT}/area.json" json)
require_json("${json}" MultraConsistencyReport format)
require_json("${json}" ON notValidated)
require_json("${json}" "${project}" provenance projectSha256)
require_json("${json}" macro provenance flowSource)
require_json("${json}" "run at compile" provenance source)
require_json("${json}" 42 provenance seeds 0)
require_json("${json}" 43 provenance seeds 1)
file(READ "${TEST_ROOT}/area.csv" csv)
string(FIND "${csv}" "# MULTRA - not yet validated." marker)
if(NOT marker EQUAL 0)
    message(FATAL_ERROR "The CSV lost its not-validated marker")
endif()
string(FIND "${csv}" "project ${project}" flows)
if(flows LESS 0)
    message(FATAL_ERROR "The CSV lacks the study-area flows line: ${csv}")
endif()
# The same project again: the same bytes.
file(COPY_FILE "${TEST_ROOT}/area.traffic.json" "${TEST_ROOT}/again.traffic.json")
report(again)
file(READ "${TEST_ROOT}/again.json" again)
string(REPLACE "again.traffic.json" "area.traffic.json" again "${again}")
if(NOT again STREQUAL json)
    message(FATAL_ERROR "Two runs gave different reports")
endif()
# A stale Macro side file shows in the marking.
report(stale)
file(READ "${TEST_ROOT}/stale.json" stale)
require_json("${stale}" macroSide marking stale 0)
# No study area: refused, nothing written.
execute_process(COMMAND "${CLI}" --data-dir "${DATA}" --project "${TEST_ROOT}/no-area.traffic.json"
                        --consistency-report "${TEST_ROOT}/no-area.json"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
string(FIND "${error}" "CONSISTENCY_NO_STUDY_AREA" refused)
if(result EQUAL 0 OR refused LESS 0 OR EXISTS "${TEST_ROOT}/no-area.json")
    message(FATAL_ERROR "No study area was not refused: result=${result}, error=${error}")
endif()
