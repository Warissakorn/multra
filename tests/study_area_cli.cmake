# Run actual CLI processes: without a side file, with a fresh one, and a comparison whose
# alternative has its own stale side file. JSON and CSV must name the exact bytes each side read.
cmake_minimum_required(VERSION 3.24)
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}")
execute_process(COMMAND "${FIXTURE}" "${TEST_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "study-area fixture: result=${result}, output=${output}, error=${error}")
endif()
file(READ "${TEST_ROOT}/expected.json" expected)
foreach(key IN ITEMS project baseSource alternativeSource generated)
    string(JSON ${key} GET "${expected}" ${key})
endforeach()

function(require_json json expected_value)
    string(JSON actual ERROR_VARIABLE error GET "${json}" ${ARGN})
    if(error OR NOT "${actual}" STREQUAL "${expected_value}")
        message(FATAL_ERROR "JSON ${ARGN}: expected '${expected_value}', got '${actual}'; ${error}")
    endif()
endfunction()
function(require_text text expected_text)
    string(FIND "${text}" "${expected_text}" position)
    if(position LESS 0)
        message(FATAL_ERROR "Missing CSV text: ${expected_text}")
    endif()
endfunction()
function(run_cli label)
    execute_process(COMMAND "${CLI}" --data-dir "${DATA}" --csv "${TEST_ROOT}/${label}.csv" ${ARGN}
                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${label}: result=${result}, output=${output}, error=${error}")
    endif()
    require_json("${output}" OFF validated)
    file(READ "${TEST_ROOT}/${label}.csv" csv)
    string(FIND "${csv}" "# MULTRA - not yet validated." marker)
    if(NOT marker EQUAL 0)
        message(FATAL_ERROR "${label}: CSV lost its not-validated marker")
    endif()
    set(report "${output}" PARENT_SCOPE)
    set(csv "${csv}" PARENT_SCOPE)
endfunction()
function(require_flows json source stale)
    require_json("${json}" meso flowSource)
    require_json("${json}" "${source}" sourceSha256)
    require_json("${json}" "${project}" projectSha256)
    require_json("${json}" "${stale}" stale)
endfunction()
function(require_marking json stale_count)
    require_json("${json}" "${generated}" generatedInArea)
    string(JSON count LENGTH "${json}" stale)
    if(NOT count EQUAL stale_count)
        message(FATAL_ERROR "Wrong stale count: ${json}")
    endif()
    if(stale_count GREATER 0)
        require_json("${json}" mesoSide stale 0)
    endif()
endfunction()

set(base "${TEST_ROOT}/base.traffic.json")
set(alternative "${TEST_ROOT}/alternative.traffic.json")
run_cli(at-compile --project "${TEST_ROOT}/no-side.traffic.json" --seed 42)
string(JSON flows GET "${report}" studyArea)
require_flows("${flows}" "" OFF) # CMake reads JSON null as an empty string
require_text("${csv}" "study area flows: meso; source run at compile; project ${project}.")
require_json("${report}" 42 seed)
string(JSON completed GET "${report}" completed)
if(NOT completed GREATER 0)
    message(FATAL_ERROR "The study-area run completed no vehicles")
endif()
set(at_compile_completed "${completed}")

foreach(kind IN ITEMS single batch)
    if(kind STREQUAL single)
        set(seeds --seed 42)
    else()
        set(seeds --seeds 42-43 --threads 1)
    endif()
    run_cli("${kind}" --project "${base}" ${seeds})
    string(JSON flows GET "${report}" studyArea)
    require_flows("${flows}" "${baseSource}" OFF)
    string(JSON marking GET "${report}" marking)
    require_marking("${marking}" 0)
    require_text("${csv}" "generated objects in the study area: ${generated}; stale inputs: none.")
    require_text("${csv}" "study area flows: meso; source ${baseSource}; project ${project}.")
    if(kind STREQUAL single)
        require_json("${report}" "${at_compile_completed}" completed)
    else()
        require_json("${report}" 42 seeds 0)
        require_json("${report}" 43 seeds 1)
        require_json("${report}" "${at_compile_completed}" perSeed 0 completed)
    endif()
endforeach()

run_cli(compare --project "${base}" --compare "${alternative}" --seeds 42-43 --threads 1)
foreach(side IN ITEMS base alternative)
    string(JSON flows GET "${report}" studyArea ${side})
    string(JSON marking GET "${report}" marking ${side})
    if(side STREQUAL "base")
        require_flows("${flows}" "${baseSource}" OFF)
        require_marking("${marking}" 0)
        set(stale_text none)
    else()
        require_flows("${flows}" "${alternativeSource}" ON)
        require_marking("${marking}" 1)
        set(stale_text mesoSide)
    endif()
    require_text("${csv}" "${side}: generated objects in the study area: ${generated}; stale inputs: ${stale_text}.")
    require_text("${csv}" "${side}: study area flows: meso; source ${${side}Source}; project ${project}.")
endforeach()
# The stale source differs only in its hash: using it must keep the same simulated result.
string(JSON difference GET "${report}" network difference)
if(NOT difference STREQUAL "0.0" AND NOT difference STREQUAL "0")
    message(FATAL_ERROR "Same saved loading changed the simulation: ${difference}")
endif()
