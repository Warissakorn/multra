# Real CLI coverage for the UTDF writer (UTDF_EXPORT §7 U1 contract, D442): the files multra-cli
# writes equal the expected files byte for byte (CRLF kept), and its refusals write nothing.
cmake_minimum_required(VERSION 3.24)
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}")
set(fixture "${SOURCE}/tests/data/utdf/u2-u0-junction.traffic.json")
foreach(mode geometric mirrored)
    set(out "${TEST_ROOT}/${mode}.csv")
    execute_process(COMMAND "${CLI}" --project "${fixture}" --export-utdf "${out}" --utdf-mode ${mode}
                    RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "${mode}: exit ${code}: ${stderr}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${out}" "${SOURCE}/tests/data/utdf/u2-u0-junction-${mode}.csv" RESULT_VARIABLE differs)
    if(differs)
        message(FATAL_ERROR "${mode}: the CLI's file differs from u2-u0-junction-${mode}.csv")
    endif()
    string(FIND "${stdout}" "UTDF_WORLD_METRES" found)
    if(found LESS 0)
        message(FATAL_ERROR "${mode}: the report is missing: ${stdout}")
    endif()
endforeach()
function(refused expected)
    execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    string(FIND "${stdout}${stderr}" "${expected}" found)
    if(code EQUAL 0 OR found LESS 0)
        message(FATAL_ERROR "Expected a refusal '${expected}', got exit ${code}: ${stdout}${stderr}")
    endif()
endfunction()
file(SHA256 "${TEST_ROOT}/geometric.csv" before)
refused("UTDF output already exists" --project "${fixture}" --export-utdf "${TEST_ROOT}/geometric.csv")
file(SHA256 "${TEST_ROOT}/geometric.csv" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "A refused export changed the existing file")
endif()
refused("--utdf-mode needs --export-utdf" --project "${fixture}" --utdf-mode mirrored)
refused("--utdf-mode needs geometric or mirrored" --project "${fixture}" --export-utdf "${TEST_ROOT}/x.csv" --utdf-mode left)
refused("--export-utdf needs --project and takes only --utdf-mode, --utdf-unsignalised and --data-dir" --project "${fixture}" --export-utdf "${TEST_ROOT}/x.csv" --seeds 1-2)
refused("--utdf-unsignalised needs --export-utdf" --project "${fixture}" --utdf-unsignalised)
refused("UTDF_NOTHING_TO_EXPORT" --project "${SOURCE}/data/projects/four-leg-signalised.traffic.json" --export-utdf "${TEST_ROOT}/none.csv")
# A Node failing NEMA: left out by default, written unsignalised on request (D443).
set(nema "${TEST_ROOT}/nema.traffic.json")
file(READ "${SOURCE}/tests/node-analysis-four-leg.traffic.json" project)
string(JSON project SET "${project}" schemaVersion 65)
string(JSON approaches LENGTH "${project}" network nodes 0 analysis approaches)
math(EXPR last "${approaches} - 1")
foreach(i RANGE ${last}) # schema 60 moved the posted speed onto the Link
    string(JSON project ERROR_VARIABLE none REMOVE "${project}" network nodes 0 analysis approaches ${i} speedLimit)
endforeach()
string(JSON project SET "${project}" network nodes 0 number 3)
file(WRITE "${nema}" "${project}")
refused("UTDF_NEMA_INVALID" --project "${nema}" --export-utdf "${TEST_ROOT}/none.csv")
execute_process(COMMAND "${CLI}" --project "${nema}" --export-utdf "${TEST_ROOT}/unsignalised.csv" --utdf-unsignalised
                RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
string(FIND "${stdout}" "UTDF_NEMA_UNSIGNALISED" found)
if(NOT code EQUAL 0 OR found LESS 0 OR NOT EXISTS "${TEST_ROOT}/unsignalised.csv")
    message(FATAL_ERROR "--utdf-unsignalised: exit ${code}: ${stdout}${stderr}")
endif()
if(EXISTS "${TEST_ROOT}/x.csv" OR EXISTS "${TEST_ROOT}/none.csv")
    message(FATAL_ERROR "A refused export wrote a file")
endif()
