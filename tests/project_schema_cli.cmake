execute_process(COMMAND "${TOOL}" RESULT_VARIABLE code OUTPUT_VARIABLE schema ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR NOT error STREQUAL "")
    message(FATAL_ERROR "Schema command failed: ${code}: ${error}")
endif()
string(JSON dialect GET "${schema}" "$schema")
string(JSON coverage GET "${schema}" "x-multra-coverage")
string(JSON complete GET "${schema}" "x-multra-complete")
string(JSON open GET "${schema}" "additionalProperties")
if(NOT dialect STREQUAL "https://json-schema.org/draft/2020-12/schema" OR
   NOT coverage STREQUAL "envelope-background-network-link-lane-connector-reference-signal-head-signal-control-right-of-way-measurements-routes-inputs" OR complete OR NOT open)
    message(FATAL_ERROR "Schema coverage or unknown-field policy changed")
endif()
string(JSON profile_count LENGTH "${schema}" "allOf")
string(JSON definition_count LENGTH "${schema}" "$defs")
if(profile_count LESS 2 OR definition_count LESS 4)
    message(FATAL_ERROR "Versioned network definitions missing")
endif()
# Check the raw JSON text: routing a uint64 bound through a double loses its value.
if(NOT schema MATCHES "18446744073709551614")
    message(FATAL_ERROR "Exact uint64 bound was lost")
endif()
execute_process(COMMAND "${TOOL}" --help RESULT_VARIABLE code OUTPUT_VARIABLE help)
if(NOT code EQUAL 0 OR NOT help MATCHES "partial")
    message(FATAL_ERROR "Schema help failed")
endif()
execute_process(COMMAND "${TOOL}" --unknown RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 2 OR NOT output STREQUAL "" OR NOT error MATCHES "Usage:")
    message(FATAL_ERROR "Unknown schema option was accepted or polluted stdout")
endif()
