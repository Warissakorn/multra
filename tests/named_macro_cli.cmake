# Real CLI coverage for saved Macro definitions (MACRO_NETWORK §21, MA21).
cmake_minimum_required(VERSION 3.24)
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}")
file(READ "${PROJECT}" fixture)
string(JSON fixture SET "${fixture}" schemaVersion 56)
string(JSON fixture SET "${fixture}" definition macroSettings
       [[{"targetGap":0.1,"maxIterations":9}]])
set(definitions [=[[
  {"id":"strict-run","name":"เช้า \"ตรวจสอบ\"\nsecond line","period":"matrix:am",
   "settings":{"targetGap":0.0001,"maxIterations":123}},
  {"id":"loose-run","name":"Loose","period":"matrix:am",
   "settings":{"targetGap":0.2,"maxIterations":7}},
  {"id":"missing-period","name":"Retained for editing","period":"no-such-period",
   "settings":{"targetGap":0.0001,"maxIterations":123}}
]]=])
string(JSON fixture SET "${fixture}" macroRuns "${definitions}")
set(project_file "${TEST_ROOT}/named-runs.traffic.json")
file(WRITE "${project_file}" "${fixture}\n")
file(SHA256 "${project_file}" source_sha)
file(SIZE "${project_file}" source_size)
string(JSON selected_name GET "${fixture}" macroRuns 0 name)

function(require_json json expected)
    string(JSON actual ERROR_VARIABLE error GET "${json}" ${ARGN})
    if(error OR NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "JSON ${ARGN}: expected '${expected}', got '${actual}'; ${error}")
    endif()
endfunction()
function(require_text text expected)
    string(FIND "${text}" "${expected}" position)
    if(position LESS 0)
        message(FATAL_ERROR "Missing output text: ${expected}")
    endif()
endfunction()
function(require_manifest report)
    string(JSON count LENGTH "${report}" inputManifest files)
    set(found OFF)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON path GET "${report}" inputManifest files ${index} logicalPath)
            if(path STREQUAL "project")
                require_json("${report}" "${source_sha}" inputManifest files ${index} sha256)
                require_json("${report}" "${source_size}" inputManifest files ${index} bytes)
                set(found ON)
            endif()
        endforeach()
    endif()
    if(NOT found)
        message(FATAL_ERROR "Macro input manifest lost its original project bytes")
    endif()
endfunction()
function(run_cli label)
    execute_process(COMMAND "${CLI}" --data-dir "${DATA}" --project "${project_file}"
                    --csv "${TEST_ROOT}/${label}.csv" ${ARGN}
                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${label}: result=${result}, output=${output}, error=${error}")
    endif()
    require_json("${output}" OFF validated)
    require_json("${output}" "matrix:am" period)
    require_manifest("${output}")
    file(READ "${TEST_ROOT}/${label}.csv" csv)
    string(FIND "${csv}" "# MULTRA - not yet validated." marker)
    if(NOT marker EQUAL 0)
        message(FATAL_ERROR "${label}: CSV lost its not-validated marker")
    endif()
    set(report "${output}" PARENT_SCOPE)
    set(csv "${csv}" PARENT_SCOPE)
endfunction()
function(refuse expected)
    execute_process(COMMAND "${CLI}" --data-dir "${DATA}" --project "${project_file}" ${ARGN}
                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 1)
        message(FATAL_ERROR "Expected refusal for ${ARGN}: result=${result}, output=${output}, error=${error}")
    endif()
    require_text("${error}" "${expected}")
endfunction()

# The global settings deliberately differ from both named definitions.
run_cli(plain --macro matrix:am)
require_json("${report}" 9 settings maxIterations)
string(JSON plain_gap GET "${fixture}" definition macroSettings targetGap)
require_json("${report}" "${plain_gap}" settings targetGap)
string(JSON ignored ERROR_VARIABLE field_error GET "${report}" runDefinition)
if(NOT field_error)
    message(FATAL_ERROR "An unnamed Macro run gained named-run metadata")
endif()
string(FIND "${csv}" "# Macro run:" named_line)
if(NOT named_line EQUAL -1)
    message(FATAL_ERROR "An unnamed Macro CSV gained a named-run line")
endif()

foreach(index IN ITEMS 0 1)
    string(JSON id GET "${fixture}" macroRuns ${index} id)
    string(JSON name GET "${fixture}" macroRuns ${index} name)
    string(JSON gap GET "${fixture}" macroRuns ${index} settings targetGap)
    string(JSON cap GET "${fixture}" macroRuns ${index} settings maxIterations)
    run_cli("${id}" --macro-run "${id}")
    require_json("${report}" "${id}" runDefinition id)
    require_json("${report}" "${name}" runDefinition name)
    require_json("${report}" "${gap}" settings targetGap)
    require_json("${report}" "${cap}" settings maxIterations)
    require_text("${csv}" "# Macro run:")
    require_text("${csv}" "\"${id}\"")
    if(index EQUAL 0)
        # JSON string encodings keep quotes and a stored newline on one identification line.
        require_text("${csv}" [[\"ตรวจสอบ\"]])
        require_text("${csv}" [[\nsecond line]])
    endif()
endforeach()

refuse(MACRO_RUN_UNKNOWN --macro-run no-such-run)
refuse(MACRO_PERIOD_UNKNOWN --macro-run missing-period)
refuse("--macro and --macro-run cannot be combined" --macro matrix:am --macro-run strict-run)
refuse("Specify --macro-run only once" --macro-run strict-run --macro-run loose-run)
refuse("--macro-run needs --project" --macro-run strict-run --seed 42)
refuse("--macro-run needs --project" --macro-run strict-run --seeds 42-43)
execute_process(COMMAND "${CLI}" --macro-run strict-run RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "A named Macro run without a project was not refused: ${result}")
endif()
require_text("${error}" "--macro-run needs --project")
file(SHA256 "${project_file}" after_sha)
if(NOT after_sha STREQUAL source_sha)
    message(FATAL_ERROR "Selecting a named run changed its source project")
endif()
