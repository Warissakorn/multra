cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED TEST_ROOT OR NOT DEFINED SYNC_SCRIPT)
    message(FATAL_ERROR "Expected TEST_ROOT and SYNC_SCRIPT")
endif()
file(REMOVE_RECURSE "${TEST_ROOT}")
set(source "${TEST_ROOT}/source")
set(build "${TEST_ROOT}/build")
set(destination "${build}/bin/data")
file(MAKE_DIRECTORY "${source}/catalog" "${destination}/catalog" "${destination}/proj")
file(WRITE "${source}/catalog/old.json" "old")
file(WRITE "${source}/keep.json" "before")
file(WRITE "${destination}/catalog/preexisting.json" "stale before first sync")
file(WRITE "${destination}/proj/proj.db" "separately managed")
file(WRITE "${TEST_ROOT}/sentinel" "outside runtime data")
function(sync)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${source}" "-DDESTINATION_DIR=${destination}"
        "-DBUILD_DIR=${build}" -DPRESERVE_PATHS=proj -P "${SYNC_SCRIPT}" COMMAND_ERROR_IS_FATAL ANY)
endfunction()
sync()
if(NOT EXISTS "${destination}/catalog/old.json" OR EXISTS "${destination}/catalog/preexisting.json")
    message(FATAL_ERROR "Initial copy must also remove stale resources left by older builds")
endif()
file(REMOVE_RECURSE "${source}/catalog")
file(WRITE "${source}/renamed.json" "new")
file(WRITE "${source}/keep.json" "after")
sync()
file(READ "${destination}/keep.json" content)
file(READ "${destination}/proj/proj.db" database)
if(EXISTS "${destination}/catalog/old.json" OR NOT EXISTS "${destination}/renamed.json" OR
   NOT content STREQUAL "after" OR NOT database STREQUAL "separately managed" OR
   NOT EXISTS "${TEST_ROOT}/sentinel")
    message(FATAL_ERROR "Runtime data must mirror updates, renames and deletions while preserving PROJ")
endif()
foreach(invalid "${source}" "${TEST_ROOT}/outside" "${build}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${source}" "-DDESTINATION_DIR=${invalid}"
        "-DBUILD_DIR=${build}" -P "${SYNC_SCRIPT}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(result EQUAL 0 OR NOT EXISTS "${source}/keep.json" OR EXISTS "${TEST_ROOT}/outside/keep.json")
        message(FATAL_ERROR "An unsafe destination must be refused before copying or deleting")
    endif()
endforeach()
