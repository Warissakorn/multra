cmake_minimum_required(VERSION 3.24)
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}")
file(READ "${PROJECT}" fixture)
string(JSON fixture SET "${fixture}" schemaVersion 57)
string(JSON fixture SET "${fixture}" network
    [=[{"id":"roads","drivingSide":"left","links":[],"connectors":[],"signalHeads":[],"roads":[
      {"id":"west","name":"West","centreline":[{"x":-200,"y":0},{"x":0,"y":0}],"crossSectionId":"section","level":0,"links":[]},
      {"id":"east","name":"East","centreline":[{"x":0,"y":0},{"x":200,"y":0}],"crossSectionId":"section","level":0,"links":[]}]}]=])
string(JSON fixture SET "${fixture}" definition crossSections
    [=[[{"id":"section","name":"Test","directions":2,"lanesForward":1,"lanesBackward":1,"laneWidth":3.5,"median":0,"linkType":"arterial","source":"Test values"}]]=])
string(JSON fixture SET "${fixture}" definition linkTypes 0 jamDensity [[{"value":120,"source":"Test values"}]])
string(JSON fixture SET "${fixture}" zoneConnectors
    [=[[{"id":"in","zoneId":"site","roadId":"west","roadDirection":"forward","direction":"origin","share":1},
       {"id":"out","zoneId":"town","roadId":"east","roadDirection":"forward","direction":"destination","share":1}]]=])
string(JSON fixture SET "${fixture}" macroRuns
    [=[[{"id":"roads-am","name":"ถนน AM","period":"matrix:am","settings":{"targetGap":0.0001,"maxIterations":25}}]]=])
set(project_file "${TEST_ROOT}/roads.traffic.json")
file(WRITE "${project_file}" "${fixture}\n")
file(SHA256 "${project_file}" source_sha)
function(require_json json expected)
    string(JSON actual GET "${json}" ${ARGN})
    if(expected MATCHES "^[0-9]+$" AND actual EQUAL expected)
        return() # JSON's 1200 and 1200.0 are the same count.
    endif()
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${ARGN} = ${expected}, got ${actual}")
    endif()
endfunction()
foreach(kind IN ITEMS normal named)
    set(selection --macro matrix:am)
    if(kind STREQUAL "named")
        set(selection --macro-run roads-am)
    endif()
    execute_process(COMMAND "${CLI}" --project "${project_file}" --data-dir "${DATA}" ${selection}
        --csv "${TEST_ROOT}/${kind}.csv" RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Road Macro CLI failed: ${result}; ${error}")
    endif()
    require_json("${report}" ON converged)
    require_json("${report}" OFF validated)
    require_json("${report}" 1200 links 0 flow composition:urban-mixed)
    require_json("${report}" 1260 links 0 load)
    require_json("${report}" 0 links 1 flow composition:urban-mixed)
    require_json("${report}" 1200 links 2 flow composition:urban-mixed)
    string(JSON count LENGTH "${report}" inputManifest files)
    math(EXPR last "${count} - 1")
    set(found OFF)
    foreach(index RANGE ${last})
        string(JSON path GET "${report}" inputManifest files ${index} logicalPath)
        if(path STREQUAL "project")
            require_json("${report}" "${source_sha}" inputManifest files ${index} sha256)
            set(found ON)
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Missing original project provenance")
    endif()
    file(READ "${TEST_ROOT}/${kind}.csv" csv)
    string(FIND "${csv}" "# MULTRA - not yet validated." marker)
    if(NOT marker EQUAL 0 OR NOT csv MATCHES "west.*1200.*1260")
        message(FATAL_ERROR "Road Macro CSV lost marker or assigned flow")
    endif()
    if(kind STREQUAL "named")
        require_json("${report}" roads-am runDefinition id)
    endif()
endforeach()
foreach(level IN ITEMS micro meso)
    set(selection --seed 42)
    if(level STREQUAL "meso")
        set(selection --meso)
    endif()
    execute_process(COMMAND "${CLI}" --project "${project_file}" --data-dir "${DATA}" ${selection}
        RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 1 OR NOT error MATCHES "ZONE_CONNECTOR_ROAD_REQUIRES_LINKS")
        message(FATAL_ERROR "${level} silently accepted Road demand: ${result}; ${error}")
    endif()
endforeach()
file(SHA256 "${project_file}" after_sha)
if(NOT after_sha STREQUAL source_sha)
    message(FATAL_ERROR "Executing Road Macro changed source bytes")
endif()
