diff --git a/src/core/rule_lookback.cpp b/src/core/rule_lookback.cpp
new file mode 100644
index 0000000..86f7d03
--- /dev/null
+++ b/src/core/rule_lookback.cpp
@@ -0,0 +1,56 @@
+#include "rule_lookback.hpp"
+#include <algorithm>
+
+namespace multra {
+namespace { bool scan(const Scenario&, const ScenarioIndex&, std::size_t, const std::vector<Vehicle>&, const std::vector<VehicleRefs>&,
+                     const RouteSlots&, const std::vector<SignalColor>&, std::size_t, const std::vector<bool>*, double); }
+void RouteSlots::build(const std::vector<VehicleRefs>& refs, std::size_t routes) {
+    start.assign(routes + 1, 0);
+    for (const auto& r : refs) ++start[r.route + 1];
+    for (std::size_t r = 0; r < routes; ++r) start[r + 1] += start[r];
+    items.resize(refs.size());
+    auto next = start;
+    for (std::size_t j = 0; j < refs.size(); ++j) items[next[refs[j].route]++] = j;
+}
+bool upstreamBlocks(const Scenario& scenario, const ScenarioIndex& index, std::size_t k, const std::vector<Vehicle>& vehicles,
+                    const std::vector<VehicleRefs>& refs, RouteSlots& slots, const std::vector<SignalColor>& headColors,
+                    std::size_t self, const std::vector<bool>* blocks, double needGap) {
+    const auto& rule = scenario.priorityRules[k];
+    if (index.majorRoutesOfRule[k].empty()) return false;
+    if (slots.start.empty()) { slots.build(refs, scenario.routes.size()); slots.ruleBlocks.assign(scenario.priorityRules.size(), -1); }
+    // Without a gap reduction the answer is the same for every minor vehicle this tick, unless the asker is itself on
+    // one of the rule's major routes (then it must not count itself).
+    const bool shared = !rule.gapReduction && std::none_of(index.majorRoutesOfRule[k].begin(), index.majorRoutesOfRule[k].end(),
+                                                           [&](const auto& m) { return m.first == refs[self].route; });
+    if (shared && slots.ruleBlocks[k] >= 0) return slots.ruleBlocks[k] == 1;
+    const bool result = scan(scenario, index, k, vehicles, refs, slots, headColors, self, blocks, needGap);
+    if (shared) slots.ruleBlocks[k] = result ? 1 : 0;
+    return result;
+}
+namespace {
+bool scan(const Scenario& scenario, const ScenarioIndex& index, std::size_t k, const std::vector<Vehicle>& vehicles,
+          const std::vector<VehicleRefs>& refs, const RouteSlots& slots, const std::vector<SignalColor>& headColors,
+          std::size_t self, const std::vector<bool>* blocks, double needGap) {
+    const auto& rule = scenario.priorityRules[k];
+    for (const auto& [route, start] : index.majorRoutesOfRule[k]) {
+        const double point = start + rule.conflictPosition;
+        for (auto i = slots.start[route]; i < slots.start[route + 1]; ++i) {
+            const auto j = slots.items[i];
+            const auto& major = vehicles[j];
+            if (j == self || major.distance > start + 1e-9) continue; // on the segment: the span scan's (D673)
+            const double reach = point - major.distance;
+            const bool near = reach <= rule.headway && (!rule.maxSpeed || major.speed <= *rule.maxSpeed);
+            if (!near && !(major.speed > 0 && reach / major.speed < needGap)) continue;
+            if (blocks && !(*blocks)[refs[j].type]) continue;
+            bool red = false; // RULE_LOOKBACK §3 rule 2: the look ends at a head that is not green
+            for (const auto& rh : index.routeHeads[route]) {
+                const double at = rh.partStart + scenario.signalHeads[rh.headIndex].position;
+                if (at >= major.distance - 1e-9 && at <= point && headColors[rh.headIndex] != SignalColor::green) { red = true; break; }
+            }
+            if (!red) return true;
+        }
+    }
+    return false;
+}
+}
+}
diff --git a/src/core/rule_lookback.hpp b/src/core/rule_lookback.hpp
new file mode 100644
index 0000000..01ff44a
--- /dev/null
+++ b/src/core/rule_lookback.hpp
@@ -0,0 +1,21 @@
+#pragma once
+#include "types.hpp"
+#include <vector>
+
+namespace multra {
+// RULE_LOOKBACK §3 (D675, option G1R): a priority rule also sees major vehicles upstream of its conflict segment.
+// The snapshot's vehicle slots grouped by route, in vehicle order, as one flat array: route r's slots are
+// items[start[r]] .. items[start[r + 1]]. Built lazily, the first time a tick needs it.
+struct RouteSlots {
+    std::vector<std::size_t> start, items;
+    std::vector<signed char> ruleBlocks; // per rule this tick: -1 not yet known; only for a rule without a gap reduction
+    void build(const std::vector<VehicleRefs>& refs, std::size_t routes);
+};
+// Whether a major vehicle whose front is not yet on rule `k`'s conflict segment blocks: its route distance to the
+// marker is within the headway (with maxSpeed), or it reaches the marker sooner than `needGap` at its speed. A
+// vehicle with a signal head that is not green between its front and the marker is not tested (Vissim with
+// "Look beyond red signals" off). `self` is never tested; `blocks` is D606's type mask or null.
+bool upstreamBlocks(const Scenario& scenario, const ScenarioIndex& index, std::size_t k, const std::vector<Vehicle>& vehicles,
+                    const std::vector<VehicleRefs>& refs, RouteSlots& slots, const std::vector<SignalColor>& headColors,
+                    std::size_t self, const std::vector<bool>* blocks, double needGap);
+}
