 void applyLineStop(FollowingResult& following, double speed, double line, const std::optional<Leader>& vehicleLeader,
                    const VehicleType& type, const DriverBehaviour& behaviour, double dt) {
     if (std::isfinite(line)) {
-        const double a = lineStopAcceleration(speed, line, type.comfortableDeceleration, type.maxDeceleration, dt);
+        double a = lineStopAcceleration(speed, line, type.comfortableDeceleration, type.maxDeceleration, dt);
+        if (const int o = zzB(); o != 0 && line > 0) {
+            // ZZ: IDM (Kesting & Treiber 2008 Eq. 2-3) toward the line, s0 = 0, leader at rest (dv = v)
+            const double am = maxAccelerationAt(type, speed), b = type.comfortableDeceleration, T = o == 3 ? 0 : zzT();
+            const double v0 = std::max(zzV0, 0.1), ss = speed * T + speed * speed / (2 * std::sqrt(am * b));
+            double idm = am * (1 - (o == 4 ? 0 : std::pow(speed / v0, 4)) - (ss / line) * (ss / line));
+            if (o >= 2) idm = std::max(idm, -(speed * speed) / (2 * line));
+            a = std::max(-type.maxDeceleration, std::min(a, idm));
+        }
         if (a < following.acceleration) { following.acceleration = a; following.mode = FollowingMode::braking; }
     }
     if (!(behaviour.w74 || behaviour.w99) || speed <= 0 || following.acceleration >= 0) return;
