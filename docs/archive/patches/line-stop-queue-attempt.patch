+// LINE_STOP §9 (D655): rows BA252–BA253. Under lineRest a standing vehicle ahead is stopped behind by the same law
+// as a line, at its rear less the standstill gap; the model follows moving vehicles only.
+namespace {
+struct Queue { double crawl{}; int clamps{}; std::vector<double> rests; bool still{}; };
+// Four cars from 40, 25, 10 and 0 m at 10 m/s toward the red line at 100 m, for 900 ticks: the longest time any
+// follower spends at 0.01–1 m/s, the clamps, and each follower's room behind the car ahead at the end.
+Queue queue(Model m, bool lineRest) {
+    auto s = redRoad(m, lineRest); s.duration = 900;
+    auto state = placed(s, {test::vehicle(1, 40, 10), test::vehicle(2, 25, 10), test::vehicle(3, 10, 10), test::vehicle(4, 0, 10)});
+    const double length = s.vehicleTypes.front().length, s0 = standstillGap(s.behaviours.front());
+    std::map<std::uint64_t, double> crawl;
+    Queue q;
+    for (int t = 0; t < 900; ++t) {
+        state = stepSimulation(std::move(state));
+        for (std::uint64_t id = 1; id <= 4; ++id) {
+            q.clamps += clamped(state, id);
+            const auto& v = find(state, id);
+            if (t > 100 && v.speed > 0.01 && v.speed < 1) crawl[id] += s.timeStep;
+        }
+    }
+    for (const auto& [id, c] : crawl) if (id > 1) q.crawl = std::max(q.crawl, c);
+    q.still = true;
+    for (std::uint64_t id = 2; id <= 4; ++id) {
+        q.rests.push_back(find(state, id - 1).distance - length - s0 - find(state, id).distance);
+        q.still = q.still && find(state, id).speed == 0;
+    }
+    return q;
+}
+}
+TEST(linestop, ba252_a_queue_behind_a_standing_car_comes_to_rest_without_a_crawl) { // BA252
+    const auto off = queue(Model::prototype, false);
+    CHECK(off.crawl > 10); CHECK(!off.still); // forcing: the prototype's following law only approaches rest
+    for (const auto m : kModels) {
+        const auto q = queue(m, true);
+        CHECK(q.still); CHECK(q.clamps == 0); CHECK(q.crawl <= 1.0);
+        for (const double r : q.rests) { CHECK(r >= -1e-9); CHECK(r <= 1e-6); }
+    }
+}
+TEST(linestop, ba253_a_moving_leader_is_followed_by_the_model_as_before) { // BA253
+    // No line and a leader at 8 m/s: on and off give the same ticks (the law reads standing vehicles only).
+    auto on = redRoad(Model::prototype, true), off = redRoad(Model::prototype, false);
+    on.signalHeads.clear(); off.signalHeads.clear();
+    auto a = placed(on, {test::vehicle(1, 30, 12), test::vehicle(2, 60, 8)}), b = placed(off, {test::vehicle(1, 30, 12), test::vehicle(2, 60, 8)});
+    for (int t = 0; t < 60; ++t) { a = stepSimulation(std::move(a)); b = stepSimulation(std::move(b)); CHECK(find(a, 1) == find(b, 1)); } // both still on the 150 m road
+}
