diff --git a/src/core/zz_probe.hpp b/src/core/zz_probe.hpp
new file mode 100644
index 0000000..c2a7486
--- /dev/null
+++ b/src/core/zz_probe.hpp
@@ -0,0 +1,26 @@
+// ZZ temporary: line-stop option switches and observations (LINE_STOP measurements). Not committed.
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <map>
+namespace multra::zz {
+inline bool env(const char* n) { const char* v = std::getenv(n); return v && *v == '1'; }
+inline bool l1() { static const bool b = env("ZZ_L1"); return b; }
+inline bool l3() { static const bool b = env("ZZ_L3"); return b; }
+inline bool floor() { static const bool b = env("ZZ_FLOOR"); return b; }
+// SUMO-style: the speed after this tick from which braking at b stops at the line (ballistic tick).
+inline double stopLaw(double v, double gap, double b, double maxDecel, double dt) {
+    const double c = gap - v * dt / 2;
+    const double v1 = c <= 0 ? 0 : b * (-dt / 2 + std::sqrt(dt * dt / 4 + 2 * c / b));
+    return std::max(-maxDecel, (v1 - v) / dt);
+}
+struct Obs { double rest = NAN, crawl = 0; int hardAfterGo = 0; bool stood = false; };
+inline std::map<std::uint64_t, Obs>& obs() { static std::map<std::uint64_t, Obs> m; return m; }
+inline void observe(std::uint64_t id, double toLine, double speed, double a, double dt) {
+    auto& o = obs()[id];
+    if (speed < 0.1 && toLine < 15) { o.rest = toLine; o.stood = true; }
+    if (toLine < 15 && speed >= 0.1 && speed < 1) o.crawl += dt;
+    if (o.stood && toLine < 15 && a < -2) ++o.hardAfterGo;
+}
+}
diff --git a/tools/zz_line_options.cpp b/tools/zz_line_options.cpp
new file mode 100644
index 0000000..880500a
--- /dev/null
+++ b/tools/zz_line_options.cpp
@@ -0,0 +1,46 @@
+// ZZ temporary: LINE_STOP option measurements. Not committed.
+#include "discharge_options.hpp"
+#include "w74_fixture_document.hpp"
+#include "../src/core/zz_probe.hpp"
+#include "../src/core/simulation.hpp"
+#include "../src/project/evaluation.hpp"
+#include "../src/project/run.hpp"
+#include <algorithm>
+#include <cstdio>
+#include <iostream>
+using namespace multra;
+int main(int, char** argv) {
+    const std::string arm = argv[1]; const std::filesystem::path project = argv[2], data = argv[3];
+    const bool discharge = std::string(argv[4]) == "1";
+    auto base = w74fixture::base(project, data);
+    std::optional<DriverBehaviour> b;
+    if (arm != "prototype") b = parseBehaviour(w74fixture::read(arm));
+    const auto d = w74fixture::arm(base, b ? &*b : nullptr, base.definition->timeStep, "probe");
+    const auto snap = compileDocument(d, data);
+    std::vector<double> rests, crawls; long clamps = 0, hard = 0, done = 0; double delay = 0; long trips = 0;
+    std::vector<double> heads, startups;
+    for (std::uint32_t seed = 42; seed <= 51; ++seed) {
+        zz::obs().clear();
+        std::optional<DischargeAccumulator> release; DischargeSpec options;
+        if (discharge) { options = DischargeOptions{}.forDuration(snap.scenario.duration); release.emplace(options, evaluationSpec(d, snap, data).queue); }
+        auto state = createSimulation(snap.scenario, seed);
+        if (release) release->observe(state);
+        while (state.tick < totalTicks(snap.scenario)) {
+            state = stepSimulation(std::move(state));
+            if (release) release->observe(state);
+            for (const auto& e : state.events) {
+                clamps += std::holds_alternative<SafetyClampEvent>(e);
+                if (const auto* a = std::get_if<ArrivedEvent>(&e)) { ++trips; delay += a->travelTime - a->freeFlowTime; }
+            }
+        }
+        for (const auto& [id, o] : zz::obs()) { if (o.stood) rests.push_back(o.rest); if (o.crawl > 0) crawls.push_back(o.crawl); hard += o.hardAfterGo; }
+        if (release) for (const auto& c : release->report()) { const auto e = estimateDischarge(c, options);
+            if (e.meanHeadway) heads.push_back(*e.meanHeadway); if (e.startupLostTime) startups.push_back(*e.startupLostTime); }
+    }
+    const auto q = [](std::vector<double> v, double p) { if (v.empty()) return double(NAN); std::sort(v.begin(), v.end()); return v[std::min(v.size() - 1, std::size_t(p * v.size()))]; };
+    const auto mean = [](const std::vector<double>& v) { double s = 0; for (double x : v) s += x; return v.empty() ? double(NAN) : s / v.size(); };
+    std::printf("stops %5zu rest med %.2f p90 %.2f max %.2f | crawl>0 %4zu med %.1fs max %.1fs | hard %4ld | clamps/run %7.1f | delay/veh %.2fs",
+        rests.size(), q(rests, .5), q(rests, .9), q(rests, 1), crawls.size(), q(crawls, .5), q(crawls, 1), hard, clamps / 10.0, trips ? delay / trips : NAN);
+    if (discharge) std::printf(" | headway %.3f startup %.3f", mean(heads), mean(startups));
+    std::printf("\n");
+}
