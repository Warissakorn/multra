if(BUILD_TESTING)
    foreach(suite IN ITEMS data layout)
        add_executable(multra-ui-audit-${suite}-tests ../../tests/ui_audit_${suite}_tests.cpp)
        target_link_libraries(multra-ui-audit-${suite}-tests PRIVATE multra_shell Qt6::Test multra_options)
        target_precompile_headers(multra-ui-audit-${suite}-tests REUSE_FROM multra_shell)
        add_test(NAME ui-audit-${suite} COMMAND multra-ui-audit-${suite}-tests "${PROJECT_SOURCE_DIR}/data")
        set_tests_properties(ui-audit-${suite} PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 90)
        add_dependencies(check multra-ui-audit-${suite}-tests)
    endforeach()
    foreach(scale IN ITEMS 1.5 2)
        add_test(NAME ui-audit-layout-${scale}x COMMAND multra-ui-audit-layout-tests "${PROJECT_SOURCE_DIR}/data")
        set_tests_properties(ui-audit-layout-${scale}x PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen;QT_SCALE_FACTOR=${scale}" TIMEOUT 90)
    endforeach()
endif()
